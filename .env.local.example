# Base URL of the `guests` fetch Cloud Function (server-only — never
# exposed to the client). In production this is the real endpoint, e.g.:
# GUESTS_ENDPOINT_URL=https://us-central1-cfweddingslive.cloudfunctions.net/guests
#
# For local dev, point this at the bundled mock server instead (see README):
GUESTS_ENDPOINT_URL=http://localhost:8787/guests
